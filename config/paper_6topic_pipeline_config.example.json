{
  "assignment": {
    "batch_size": 4096,
    "output_label_for_no_match": "OUTSIDE_SCOPE",
    "score_margin": 0.02,
    "similarity_threshold": 0.65,
    "apply_score_margin_to_positive_mask": false,
    "score_margin_role": "diagnostic_by_default",
    "sensitivity_analysis_note": "Set apply_score_margin_to_positive_mask=true to require the configured margin in an optional sensitivity run."
  },
  "bertopic": {
    "classifier_name": "LogisticRegression",
    "classifier_params": {
      "class_weight": "balanced",
      "max_iter": 3000
    },
    "include_outside_scope_in_fit": false,
    "top_n_words": 10,
    "vectorizer_max_df": 0.95,
    "vectorizer_min_df": 1
  },
  "embedding": {
    "dims": 1024,
    "model_name": "BAAI/bge-large-en-v1.5"
  },
  "paths": {
    "workflow_root": ".",
    "dataset_dir": "data/external",
    "dataset_corpus": "data/external/filtered_corpus.parquet",
    "dataset_embeddings": "data/external/filtered_embeddings.f32",
    "dataset_embedding_meta": "data/external/filtered_embeddings.meta.json",
    "dataset_summary": "data/external/subset_summary.json",
    "stable_label_catalog_csv": "catalog/six_topic_discourse_catalog.csv",
    "stable_label_catalog_json": "catalog/six_topic_discourse_catalog.json",
    "full_output_root": "outputs/cosine",
    "labeled_corpus": "outputs/cosine/labeled_corpus.parquet",
    "positive_labeled_corpus": "outputs/cosine/best_only_positive.parquet",
    "document_topics": "outputs/bertopic_micro_unsupervised_multiaspect/document_topics.parquet",
    "topic_info_csv": "outputs/bertopic_micro_unsupervised_multiaspect/topic_info.csv",
    "label_topic_mapping_csv": "outputs/bertopic_micro_unsupervised_multiaspect/label_topic_mapping.csv",
    "manifest_json": "outputs/bertopic_micro_unsupervised_multiaspect/manifest.json",
    "model_dir": "outputs/bertopic_micro_unsupervised_multiaspect/bertopic_model",
    "descriptive_analysis_dir": "outputs/bertopic_micro_unsupervised_multiaspect/descriptive_analysis"
  }
}
